<section class="tarjeta">
  <h2><%= seccion %></h2>

  <p>
    En esta seccion podes consultar todas las reservas registradas.
  </p>

  <div class="acciones">
    <a class="boton" href="/reservas/nueva">
      Nueva reserva
    </a>
  </div>
</section>

<% if (reservas.length === 0) { %>

  <section class="tarjeta">
    <h3>No hay reservas</h3>

    <p>
      Actualmente no hay reservas registradas.
    </p>
  </section>

<% } else { %>

  <section class="tarjeta">
    <h3>Reservas registradas</h3>

    <div class="tabla-contenedor">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Estudiante</th>
            <th>Sala</th>
            <th>Fecha</th>
            <th>Turno</th>
            <th>Personas</th>
            <th>Acción</th>
          </tr>
        </thead>

        <tbody>
          <% reservas.forEach((reserva) => { %>
            <tr>
              <td><%= reserva.id %></td>
              <td><%= reserva.estudiante %></td>
              <td><%= reserva.sala %></td>
              <td><%= reserva.fecha %></td>
              <td><%= reserva.turno %></td>
              <td><%= reserva.personas %></td>
              <td>
                <a href="/reservas/<%= reserva.id %>">
                  Ver detalle
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

<% } %>