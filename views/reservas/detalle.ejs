<section class="tarjeta">
  <h2>Detalle de la reserva</h2>

  <p>
    Informacion  de la reserva seleccionada.
  </p>

  <dl class="detalle">
    <div>
      <dt>ID</dt>
      <dd><%= reserva.id %></dd>
    </div>

    <div>
      <dt>Estudiante</dt>
      <dd><%= reserva.estudiante %></dd>
    </div>

    <div>
      <dt>Email</dt>
      <dd><%= reserva.email %></dd>
    </div>

    <div>
      <dt>Sala</dt>
      <dd><%= reserva.sala %></dd>
    </div>

    <div>
      <dt>Fecha</dt>
      <dd><%= reserva.fecha %></dd>
    </div>

    <div>
      <dt>Turno</dt>
      <dd><%= reserva.turno %></dd>
    </div>

    <div>
      <dt>Personas</dt>
      <dd><%= reserva.personas %></dd>
    </div>
  </dl>

  <div class="acciones">
    <a class="boton" href="/reservas">
      Volver a reservas
    </a>

    <a class="boton" href="/reservas/nueva">
      Nueva reserva
    </a>
  </div>
</section>